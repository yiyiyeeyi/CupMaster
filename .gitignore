# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.env.local
.env*.local

# Supabase CLI local link/cache metadata
/supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local vision datasets (schemas/examples remain tracked)
/data/vision/raw/
/data/vision/frames/
/data/vision/annotations/
/data/vision/exports/
/data/vision/manifest.json
/data/vision/*.local.json
/data/vision/*.zip

# Local ML experiments, checkpoints, exports, and framework caches
/.vision-work/

# Python bytecode generated by vision tooling
__pycache__/
*.pyc
